{
  "name": "@wavc/dj-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Party DJ's mixing engine, running headless. Renders the Web Audio graph on the server and publishes PCM to Liquidsoap.",
  "exports": {
    ".": "./src/index.ts",
    "./mixer": "./src/engine/mixer.ts",
    "./engine/types": "./src/engine/types.ts",
    "./deck": "./src/engine/deck.ts",
    "./analysis": "./src/engine/analysis.ts",
    "./transitions": "./src/engine/transitions.ts",
    "./marathon": "./src/engine/marathon.ts",
    "./scratch": "./src/engine/scratch.ts",
    "./sync": "./src/engine/sync.ts",
    "./synthTracks": "./src/engine/synthTracks.ts",
    "./timePitchEngine": "./src/engine/timePitchEngine.ts",
    "./audio": "./src/audio/index.ts",
    "./ingest": "./src/ingest/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000 ./test/"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@wavc/scratch-agent": "workspace:*",
    "@wavc/station-core": "workspace:*",
    "node-web-audio-api": "^2.1.0"
  }
}