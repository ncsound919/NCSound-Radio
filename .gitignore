# The generated music library at the repo root only. Anchored so it does not
# also swallow source directories named "library" (e.g. apps/dj-console/src/library).
/library/
analysis/.venv/
analysis/.cache/
analysis/out/
*.db-journal
*.db-wal
*.db-shm
# station-web database: live runtime state, plus three pre-wipe snapshots sitting
# beside it (custom.db.pre-campaign-wipe, .pre-demock, .pre-wipe2). Not source.
# Regenerate from prisma/schema.prisma + the seed scripts.
apps/station-web/db/
# decoded-analysis cache: regenerated from the library, never committed
.ncsound-cache/

# infra/backup-state.mjs output: runtime snapshots, never source. Anchored so a
# same-named source directory elsewhere is not swallowed.
/backups/

# Python bytecode caches (analysis/ scripts)
__pycache__/
*.pyc

# wrangler/miniflare local state
.wrangler/
