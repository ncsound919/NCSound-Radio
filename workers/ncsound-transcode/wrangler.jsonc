{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncsound-transcode",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "TranscodeContainer",
      "image": "./Dockerfile",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSCODE",
        "class_name": "TranscodeContainer"
      }
    ]
  },
  "exports": {
    "TranscodeContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "*"
  }
}
