{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncsound-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ncsound-media"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "ncsound-tracks"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "*"
  }
}
