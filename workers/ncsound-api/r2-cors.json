{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-none-match", "if-modified-since", "content-type"]
      },
      "exposeHeaders": ["content-length", "content-range", "accept-ranges", "etag"],
      "maxAgeSeconds": 3600
    }
  ]
}
