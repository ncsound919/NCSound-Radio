// NCSound Radio "NCSound Radio" — station data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Supabase this is the Supavisor pooler (port 6543,
  // `?pgbouncer=true`); locally it is the plain Postgres server.
  url      = env("DATABASE_URL")
  // Migrations and `prisma db pull` need a direct (non-pooled) connection.
  // Supabase: port 5432. Locally it is the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model Artist {
  id         String   @id @default(cuid())
  name       String
  email      String?
  city       String?
  state      String?
  instagram  String?
  soundcloud String?
  createdAt  DateTime @default(now())
}

model Submission {
  id                  String    @id @default(cuid())
  artistName          String
  email               String
  trackTitle          String
  genre               String
  explicit            Boolean   @default(false)
  city                String?
  state               String?
  socials             String?
  fileName            String?
  fileSize            Int?
  notes               String?
  status              String    @default("PENDING") // PENDING | IN_REVIEW | APPROVED | DECLINED
  agreementVersion    String    @default("v1.1")
  agreementAcceptedAt DateTime?
  agreementIp         String?
  reviewNotes         String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([status])
}

// Note: Submission↔Artist linked by name (loose coupling); no strict relation needed.

model Sponsor {
  id          String     @id @default(cuid())
  name        String
  contact     String
  tier        String // ON_AIR_SPOT | SHOW_SPONSOR | DAYPART_SPONSOR
  monthlyRate Int // cents
  status      String     @default("ACTIVE") // ACTIVE | PENDING | ENDED
  startAt     DateTime   @default(now())
  endAt       DateTime?
  campaigns   Campaign[]
}

model Campaign {
  id           String   @id @default(cuid())
  sponsorId    String
  sponsor      Sponsor  @relation(fields: [sponsorId], references: [id])
  name         String
  spotsPerDay  Int      @default(6)
  creativeName String
  startAt      DateTime @default(now())
  endAt        DateTime?
  active       Boolean  @default(true)
  adPlays      AdPlay[]
}

model AdPlay {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  playedAt   DateTime
  /// Provenance of this row. `program-clock` means the ad-sync job computed it
  /// from the station's own schedule and the on-air clock.
  ///
  /// The default used to be `azuracast-history`, which asserted these rows were
  /// pulled from a broadcaster's song-history API. There is no AzuraCast in
  /// this stack; the rows were computed here and then labelled as someone
  /// else's telemetry, which made computed proof-of-play indistinguishable
  /// from externally attested proof-of-play.
  source     String   @default("program-clock")

  @@index([playedAt])
  @@unique([campaignId, playedAt])
}

model Show {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  host        String
  dayOfWeek   Int // 0=Sun .. 6=Sat (America/New_York)
  startHour   Int // 0-23 ET
  startMinute Int     @default(0)
  durationMin Int
  explicit    Boolean @default(false)
  kind        String  @default("PLAYLIST") // PLAYLIST | LIVE
  accent      String  @default("amber")
  active      Boolean @default(true)
}

model Track {
  id          String   @id @default(cuid())
  title       String
  artist      String
  album       String?
  durationSec Int
  explicit    Boolean  @default(false)
  playlist    String // Core Rotation | New Heat | Throwbacks | Clean Daypart | Fallback | Imaging | Ads
  bpm         Int?
  /// SoundExchange Reports of Use prefer ISRCs. Null until known; not invented.
  isrc        String?
  /// Marketing label / rights-holder line for Reports of Use.
  label       String?
  seedOrder   Int      @unique
  createdAt   DateTime @default(now())

  playLogs      PlayLog[]
  trackRequests TrackRequest[]
}

model PlayLog {
  id       String   @id @default(cuid())
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id])
  playedAt DateTime
  source   String   @default("AUTODJ") // AUTODJ | LIVE

  @@unique([trackId, playedAt])
  @@index([playedAt])
}

model TrackRequest {
  id           String   @id @default(cuid())
  trackId      String
  track        Track    @relation(fields: [trackId], references: [id])
  listenerName String
  /// Supabase auth user id, when the request carried a valid session. Null for
  /// anonymous web listeners (who still provide listenerName).
  userId       String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([trackId, listenerName])
  @@index([createdAt])
}

model StationSetting {
  key   String @id
  value String
}
