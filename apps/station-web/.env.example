# station-web environment — copy to `.env` and fill in. Never commit `.env`.
# (`.env` is gitignored; this example is committed.)

# --- database (Postgres / Supabase) -----------------------------------------
# Runtime connection. On Supabase this is the Supavisor SESSION pooler (port
# 5432) — see the Supabase block below. Local dev: a Postgres server, e.g.
#   docker run -d --name ncsound-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ncsound -p 5433:5432 postgres:15
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ncsound?schema=public
# Direct connection, used only by `prisma migrate`. Locally it is the same as
# DATABASE_URL; on Supabase it is the same session-pooler host.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5433/ncsound?schema=public
# Supabase (project xczjyhsibnjbjhpvtotx, us-east-1) — SERVER deployment:
#   Use the Supavisor SESSION pooler (port 5432) for BOTH urls. The direct
#   `db.<ref>.supabase.co` host is IPv6-only without the IPv4 add-on, and this
#   server has no IPv6. Session mode supports prepared statements, so there is
#   NO `pgbouncer=true` here (that flag is for the transaction pooler, 6543,
#   which is only needed for serverless/auto-scaling).
#   DATABASE_URL=postgresql://prisma.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&connect_timeout=30
#   DIRECT_URL=postgresql://prisma.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30
#
# `connection_limit=5` keeps Prisma's own pool under Supabase's default
# Supavisor pool size (15); the v6 default is num_cpus*2+1, which can exceed it
# ("Max client connections reached"). Create the `prisma` role first with
# scripts/supabase-prisma-role.sql (recommended over the postgres superuser).
#
# MIGRATIONS: apply with `prisma migrate deploy` only. This `public` schema also
# holds the identity tables (profiles/favorites/devices/push_prefs) that Prisma
# does not manage; `prisma migrate dev` / `db push` would see them as drift and
# try to drop them. Generate migrations locally, deploy here.
# The DB password is a vault secret (Keywire). Never commit it.

# --- ingest (the DJ engine control plane) -----------------------------------
INGEST_URL=http://127.0.0.1:8137
# Master credential for the engine's owner plane. Required to send commands
# (api/ops/command) and to mint/revoke host & guest session credentials
# (api/ops/slots, C5). Must match the engine's INGEST_TOKEN. Server-side only —
# never ship it to the browser or the app.
# INGEST_TOKEN=

# --- host/guest doors (C4) --------------------------------------------------
# Public base URL of the guest console, used to build invite links in the
# Shows & slots panel. Set once the door is deployed behind Cloudflare Access.
# NEXT_PUBLIC_GUEST_CONSOLE_URL=https://guest.example.com

# --- stream (Icecast) -------------------------------------------------------
# Loopback on the station PC; the VPS relay over TLS in production.
# Either variable works; NEXT_PUBLIC_* also reaches the browser.
NEXT_PUBLIC_STREAM_BASE_URL=https://stream.example.com
# NCSOUND_STREAM_BASE_URL=https://stream.example.com
NEXT_PUBLIC_ICECAST_PORT=8010

# --- public API origin (CORS) ----------------------------------------------
# Blank/`*` for the app; set to your site origin to lock it down.
NEXT_PUBLIC_API_ORIGIN=*

# --- Supabase (request attribution) ----------------------------------------
# Used server-side to resolve the caller of POST /api/requests from their JWT.
# Both values are publishable. Without them, requests stay anonymous (name only).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=

# --- live video (Cloudflare Stream) ----------------------------------------
# SHOW-ONLY video. The token is server-side only; never expose it to the app.
# STREAM_API_TOKEN=            # Cloudflare API token with Account > Stream Edit
# STREAM_CUSTOMER_CODE=        # customer-<CODE>.cloudflarestream.com
# STREAM_LIVE_INPUT_ID=        # the ncsound-obs live input uid
