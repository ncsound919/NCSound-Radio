# Release signing config for the sideloaded APK.
#
# Copy this file to android/keystore.properties and fill it in. The real file and
# the keystore are gitignored — never commit either.
#
# Generate the keystore (validity 10000 days is the Play minimum):
#   keytool -genkeypair -v -storetype PKCS12 -keystore ncsound-release.keystore \
#     -alias ncsound -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/app, so a keystore sitting next to
# this file is "../ncsound-release.keystore".
storeFile=../ncsound-release.keystore
storePassword=CHANGE_ME
keyAlias=ncsound
keyPassword=CHANGE_ME
