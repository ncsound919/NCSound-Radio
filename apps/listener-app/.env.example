# NCSound listener app — environment (react-native-config)
#
# Copy to `.env.development` (or `.env.production`) and fill in. Values are baked
# into the build by react-native-config, so a change needs a rebuild, not a
# reload. Everything here is non-secret / publishable — never put a service-role
# key or any secret in this file (it ships in the app bundle).

# Public JSON API base (Cloudflare Tunnel `api.<domain>`, or the deployed site).
# Loopback default keeps local development working.
API_BASE_URL=http://127.0.0.1:3100

# Icecast stream base. Loopback in dev; the VPS relay over TLS in production.
# The app also reads the authoritative descriptor from GET /api/stream.
STREAM_BASE_URL=http://127.0.0.1:8010

# Supabase publishable values. RLS is the security boundary.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sentry DSN (crash/error tracking). Blank disables Sentry.
SENTRY_DSN=
