{
  "name": "@ncsound/dj-console",
  "private": true,
  "version": "0.0.1",
  "description": "NCSound DJ Console — the booth. Packaged as a Windows beta app (Electron); the DJ side is live, the station backend is not included.",
  "author": "NCSound",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "guest": "vite preview --config vite.guest.config.ts",
    "guest:dev": "vite --config vite.guest.config.ts",
    "build": "tsc && vite build",
    "exe": "bun run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit",
    "test": "bun test/analysis.test.ts && bun test/sync.test.ts && bun test/sentence.test.ts && bun test/timePitch.test.ts && bun test/dj_mixer.test.ts && bun test/marathon_crate.test.ts && bun test/mpd226.test.ts && bun test/shortcutScope.test.ts && bun test/library.test.ts && bun test/audibleDeck.test.ts && bun test/liveClient.test.ts && bun test/station.test.ts && bun test/r2.test.ts && bun test/remap.test.ts && bun test/broadcastLink.test.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "ui-audit": "node scripts/audit-ui.mjs",
    "mix-check": "node scripts/mix-check.mjs",
    "fx-check": "node scripts/fx-check.mjs",
    "library-check": "node scripts/library-check.mjs",
    "sampler-check": "node scripts/sampler-check.mjs",
    "obs-check": "node scripts/obs-check.mjs",
    "obs-live-check": "node scripts/obs-live-check.mjs",
    "r2-check": "node scripts/r2-check.mjs",
    "r2-offline-check": "node scripts/r2-offline-check.mjs",
    "live-check": "node scripts/live-check.mjs",
    "requests-check": "node scripts/requests-check.mjs",
    "mic-check": "node scripts/mic-check.mjs"
  },
  "dependencies": {
    "@ncsound/dj-engine": "workspace:*",
    "@ncsound/scratch-agent": "workspace:*",
    "@ncsound/station-core": "workspace:*",
    "obs-websocket-js": "5",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "demucs-web": "1.0.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "onnxruntime-web": "1.30.0",
    "playwright": "1.48.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "fm.ncsound.djconsole.beta",
    "productName": "NCSound DJ Console",
    "directories": {
      "output": "release-beta"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "NCSound-DJ-Console-Beta-${version}.exe"
    }
  }
}
