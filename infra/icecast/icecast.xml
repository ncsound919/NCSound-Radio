<?xml version="1.0"?>
<!--
  NCSound Radio - Icecast 2.4 streaming server.

  Two things that cost time to discover, both encoded here:

  1. Source auth must be GLOBAL, in <authentication>. Per-mount
     <source-username>/<source-password> was silently ignored by this
     build and every source connection returned 401
     ("No source password set, rejecting source"). With a global
     <source-password> the source username defaults to "source".

  2. This Ubuntu build has a compiled-in prefix of /usr/local/icecast and
     was resolving <webroot>/<adminroot> against it, so status.xml 400s.
     infra/station-up.sh symlinks those defaults at /usr/share/icecast2,
     which is what makes the status pages reachable.

  3. The JSON status page lives at /status-json.xsl, NOT /admin/status-json.xsl.
     Anything under /admin/ is parsed as a source/admin command rather than
     served from adminroot, so /admin/status-json.xsl answers
     "400 - Unrecognised command". An authenticated curl of
     http://127.0.0.1:8010/status-json.xsl is the one to poll.

  4. Port 8010, not Icecast's default 8000: an unrelated Windows service
     already holds 127.0.0.1:8000, and WSL2's localhost relay cannot shadow
     a Windows listener. The DJ engine runs on Windows and needs to read these
     stats over HTTP, so Icecast gets a port nothing else is using.

  Credentials are DEV DEFAULTS - change before exposing beyond localhost.

  Note: XML comments cannot contain a double hyphen.
-->
<icecast>
  <location>Localhost</location>
  <admin>ops@ncsound.local</admin>
  <!-- Must not be literally "localhost" or Icecast warns and treats it unset. -->
  <hostname>ncsound.local</hostname>

  <listen-socket>
    <port>8010</port>
    <bind-address>127.0.0.1</bind-address>
  </listen-socket>

  <!--
    TEMPLATE. The two passwords below are __PLACEHOLDERS__ rendered by
    infra/station-up.sh from infra/icecast/.env at copy time. Icecast's XML has no
    environment substitution, so this file is the only place a password could leak
    back into git, and it leaked: the admin and source passwords were both tracked
    here and are still in history. Do not put a real value in this file.
    (This comment previously contained a double hyphen and Icecast refused to parse
    the file with "Double hyphen within comment". The warning at the top of this
    file is not decorative.)

    A leftover placeholder means the render did not run, and Icecast would accept
    the placeholder text itself as the password. station-up.sh therefore checks
    for an unrendered marker inside a password element and refuses to start.
  -->
  <authentication>
    <source-password>__ICECAST_SOURCE_PASSWORD__</source-password>
    <admin-user>admin</admin-user>
    <admin-password>__ICECAST_ADMIN_PASSWORD__</admin-password>
  </authentication>

  <webroot>/usr/share/icecast2/web</webroot>
  <adminroot>/usr/share/icecast2/admin</adminroot>
  <fileserve>1</fileserve>

  <security>
    <chroot>0</chroot>
    <change-owner>
      <user>icecast2</user>
      <group>icecast</group>
    </change-owner>
  </security>

  <!-- Primary mount: 128 kbps from Liquidsoap. -->
  <mount type="normal">
    <mount-name>/live.mp3</mount-name>
    <public>1</public>
    <hidden>0</hidden>
    <max-listeners>500</max-listeners>
    <queue-size>1048576</queue-size>
    <stream-name>NCSound Radio</stream-name>
    <stream-description>Independent hip-hop radio</stream-description>
    <genre>Various</genre>
  </mount>

  <!-- Mobile mount: 64 kbps. Matches the 128/64 switch in the station player. -->
  <mount type="normal">
    <mount-name>/mobile.mp3</mount-name>
    <public>1</public>
    <hidden>0</hidden>
    <max-listeners>500</max-listeners>
    <queue-size>1048576</queue-size>
    <stream-name>NCSound Radio (mobile)</stream-name>
    <genre>Various</genre>
  </mount>

  <fileserve-ttl>10</fileserve-ttl>
</icecast>