# Contract for infra/stream/.env (the VPS relay). Copy and fill in:
#   cp infra/stream/.env.example infra/stream/.env && chmod 600 infra/stream/.env

# Source password the home Liquidsoap uses to push /live.mp3 and /mobile.mp3
# here. Must equal the source password in the home ncsound.liq output.icecast.
ICECAST_SOURCE_PASSWORD=replace-with-32-hex-chars

# Admin password for the relay's /admin pages and the /status-json.xsl poller.
ICECAST_ADMIN_PASSWORD=replace-with-32-hex-chars

# Your home IP as seen by the VPS. Firewall the source port (8000) to this only.
NCSOUND_HOME_IP=replace-with-your-home-ip

# The public hostname: a DNS-only A record pointing at the VPS.
NCSOUND_STREAM_HOST=stream.example.com
