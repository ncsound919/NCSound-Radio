{
  "name": "ncsound-station",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/station-web/mini-services/*"
  ],
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "scripts": {
    "typecheck": "bun run --filter='@ncsound/*' typecheck",
    "test": "bun run --filter='@ncsound/*' test",
    "test:core": "bun test ./packages/station-core/test/contract.test.ts",
    "build:web": "bun run --filter='@ncsound/station-web' build",
    "db:generate": "bun run --filter='@ncsound/station-web' db:generate"
  }
}